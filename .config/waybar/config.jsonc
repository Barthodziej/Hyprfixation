{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "margin-top" : 10,
    "margin-left" : 10,
    "margin-right" : 10,
    "modules-left": [
	"custom/music",
	"custom/separator"
    ],
    "modules-center": [
	"clock"
    ],
    "modules-right": [
	"custom/separator",
	"wireplumber#source",
	"custom/separator",
	"wireplumber#sink",
	"custom/separator",
	"backlight",
	"custom/separator",
	"bluetooth",
	"custom/separator",
	"network",
	"custom/separator",
	"battery",
	"custom/separator",
	"custom/power"
    ],
    "custom/aboba" : {
        "format": "aboba",
	"return-type": "json",
	"exec": "~/.config/waybar/scripts/aboba.sh"
    },
    "custom/music" : {
        "format": "{icon} {text}",
	"format-icons": {
	    "Playing": "",
	    "Paused": "",
	    "Stopped": "",
	    "No": ""
	},
	"return-type": "json",
	"exec": "~/.config/waybar/scripts/music/music-module.sh",
	"on-click": "playerctl play-pause"
    },
    "clock": {
	"timezone": "Europe/Warsaw",
	"format": "{:L%A, %d %b %Y - %H:%M}",
	"locale": "pl_PL.UTF-8",
	"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	"format-alt": "{:%Y-%m-%d}"
    },
    "temperature": {
	// "thermal-zone": 2,
	// "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
	"critical-threshold": 80,
	// "format-critical": "{temperatureC}°C {icon}",
	"format": "{icon}",
	"tooltip-format": "Temp: {temperatureC}°C",
	"format-icons": ["", "", ""]
    },
    "battery": {
	"states": {
	    // "good": 95,
	    "warning": 30,
	    "critical": 15
	},
	"format": "{capacity}% {icon}",
	"format-full": "{capacity}% {icon}",
	"format-charging": "{capacity}% ",
	"format-plugged": "{capacity}% ",
	"format-alt": "{time} {icon}",
	// "format-good": "", // An empty format will hide the module
	// "format-full": "",
	"format-icons": ["", "", "", "", ""]
    },
    "backlight": {
	"format": "{percent}% 󰌵",
	"interval": 1
    },
    "bluetooth": {
	"format-off": "󰂲",
	"format-on": "",
	"format-connected": "󰂱",
	"tooltip-format-off": "Off",
	"tooltip-format-on": "On",
	"tooltip-format-connected": "Connected\n{device_alias}",
	"on-click": "if hyprctl clients | grep \"class: floating_bluetui\"; then hyprctl dispatch killwindow class:floating_bluetui; else kitty --class \"floating_bluetui\" -e bluetui; fi"
    },    
    "network": {
	"format": "{icon}",
	//"format-disconnected": "Disconnected ⚠",
	"format-icons": {
	    "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"],
	    "ethernet": "󰈁",
	    "disconnected": "󰖪"
	},
	"tooltip-format-wifi": "{essid}\n󰜮 {bandwidthDownBytes}\n󰜷 {bandwidthUpBytes}",
	"on-click": "if hyprctl clients | grep \"class: floating_nmtui\"; then hyprctl dispatch killwindow class:floating_nmtui; else kitty --class \"floating_nmtui\" -e nmtui; fi"
    },
    "wireplumber#source" : {
	"node-type": "Audio/Source",
	"scroll-step": 2,
	"format": "{volume}% ",
	"format-muted": "muted ",
	"on-click": "if hyprctl clients | grep \"class: floating_wiremix\"; then hyprctl dispatch killwindow class:floating_wiremix; else kitty --class \"floating_wiremix\" -e wiremix --tab input; fi"
    },
    "wireplumber#sink" : {
	"node-type": "Audio/Sink",
	"scroll-step": 2,
	"format": "{volume}% {icon}",
	"format-bluetooth": "{volume}% {icon}",
	"format-muted": "muted {icon}",
	"format-icons": {
	    "headphone": "",
	    "hands-free": "",
	    "headset": "",
	    "phone": "",
	    "portable": "",
	    "car": "",
	    "default": ["", "", ""]
	},
	"on-click": "if hyprctl clients | grep \"class: floating_wiremix\"; then hyprctl dispatch killwindow class:floating_wiremix; else kitty --class \"floating_wiremix\" -e wiremix --tab output; fi"
    },
    "custom/power": {
	"format" : "⏻",
	"tooltip": false,
	"menu": "on-click",
	"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
	"menu-actions": {
	    "lock": "swaylock -f",
	    "shutdown": "shutdown 0",
	    "reboot": "reboot",
	    "suspend": "systemctl suspend",
	    "hibernate": "systemctl hibernate"
	}
    },
    "custom/separator": {
	"format" : "┋" 
    }
}
